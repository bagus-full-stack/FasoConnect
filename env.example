# ── HuggingFace ──────────────────────────────────────
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Sécurité API ─────────────────────────────────────
# Génère une clé forte : openssl rand -hex 32
API_KEY=change_moi_avec_une_cle_forte_32_chars

# ── CORS ─────────────────────────────────────────────
# En dev : laisser * ou http://localhost:4200
# En prod : mettre ton domaine exact
ALLOWED_ORIGIN=https://ton-domaine.com

# ── Cache ─────────────────────────────────────────────
CACHE_TTL=3600

# ── Timeout inférences (secondes) ────────────────────
INFER_TIMEOUT=60
