# ── HuggingFace ───────────────────────────────
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Sécurité API ─────────────────────────────
# Génère avec : openssl rand -hex 32
API_KEY=change_moi_avec_une_cle_forte

# ── CORS ─────────────────────────────────────
# Dev  : *
# Prod : https://ton-domaine.com
ALLOWED_ORIGIN=*

# ── Base de données ──────────────────────────
