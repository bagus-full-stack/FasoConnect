{
  "info": {
    "name": "FasoConnect — API Linguistique Burkinabè v1.0",
    "description": "Collection complète : Traduction (NLLB-200) + TTS (MMS) + Historique",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
