  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "api_key",  "value": "ta_cle_api_ici",       "type": "string" }
  ],
  "item": [
    {
      "name": "Système",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          }
        },
        {
          "name": "Langues disponibles",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/languages", "host": ["{{base_url}}"], "path": ["languages"] }
          }
        }
      ]
    },
