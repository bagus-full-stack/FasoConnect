    {
      "name": "Historique",
      "item": [
        {
          "name": "POST Creer une entree",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{api_key}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"user_id\": \"user_001\",\n  \"action_type\": \"translate\",\n  \"src_lang\": \"francais\",\n  \"tgt_lang\": \"moore\",\n  \"source_text\": \"Bonjour tout le monde\",\n  \"result_text\": \"Ne y welame\"\n}" },
            "url": { "raw": "{{base_url}}/history", "host": ["{{base_url}}"], "path": ["history"] }
          }
        },
        {
          "name": "GET Liste paginee",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }],
            "url": {
              "raw": "{{base_url}}/history?limit=10&offset=0",
              "host": ["{{base_url}}"],
              "path": ["history"],
              "query": [
                { "key": "limit",  "value": "10" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "GET Filtrer par user_id",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }],
            "url": {
              "raw": "{{base_url}}/history?user_id=user_001&limit=10&offset=0",
              "host": ["{{base_url}}"],
              "path": ["history"],
              "query": [
                { "key": "user_id", "value": "user_001" },
                { "key": "limit",   "value": "10" },
                { "key": "offset",  "value": "0" }
              ]
            }
          }
        },
        {
          "name": "GET Filtrer par action_type",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }],
            "url": {
              "raw": "{{base_url}}/history?action_type=translate&limit=10&offset=0",
              "host": ["{{base_url}}"],
              "path": ["history"],
              "query": [
                { "key": "action_type", "value": "translate" },
                { "key": "limit",       "value": "10" },
                { "key": "offset",      "value": "0" }
              ]
            }
          }
        },
        {
          "name": "GET Filtrer par lang",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }],
            "url": {
              "raw": "{{base_url}}/history?lang=moore&limit=10&offset=0",
              "host": ["{{base_url}}"],
              "path": ["history"],
              "query": [
                { "key": "lang",   "value": "moore" },
                { "key": "limit",  "value": "10" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "DELETE Supprimer une entree",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }],
            "url": {
              "raw": "{{base_url}}/history/REMPLACE-PAR-UUID",
              "host": ["{{base_url}}"],
              "path": ["history", "REMPLACE-PAR-UUID"]
            }
          }
        },
        {
          "name": "DELETE Vider historique utilisateur",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-API-Key", "value": "{{api_key}}" }],
            "url": {
              "raw": "{{base_url}}/history?user_id=user_001",
              "host": ["{{base_url}}"],
              "path": ["history"],
              "query": [{ "key": "user_id", "value": "user_001" }]
            }
          }
        }
      ]
    },
